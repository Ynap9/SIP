<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     autoReload="true"
     throwConfigExceptions="true">
	<targets>
		<!-- Console logging -->
		<target xsi:type="ColoredConsole" name="console">
			<layout>${longdate} | ${level:uppercase=true} | ${logger} | ${message} ${exception}</layout>
			<highlight-word text="DEBUG" foregroundColor="DarkGray" />
			<highlight-word text="INFO" foregroundColor="Green" />
			<highlight-word text="WARN" foregroundColor="Yellow" />
			<highlight-word text="ERROR" foregroundColor="Red" />
			<highlight-word text="FATAL" foregroundColor="DarkRed" />
		</target>
		<!-- File logging.
		     Thư mục do code quyết định lúc chạy và truyền vào qua biến môi trường SIPPACK_LOG_DIR:
		     ưu tiên thư mục Log\ cạnh app (dễ tìm nhất), tự lùi về %AppData%\SipPack\logs khi chỗ đó
		     không ghi được - bản cài trong Program Files không cho user thường ghi, cố ghi ở đó là
		     mất sạch log đúng lúc cần nhất.
		     Dùng biến MÔI TRƯỜNG chứ không dùng ${var:} của NLog: autoReload nạp lại cấu hình sẽ xoá
		     biến đặt bằng code, còn biến môi trường thì sống suốt tiến trình.
		     whenEmpty giữ đường lui khi chạy ngoài luồng BuildApp (test, tool) -> vẫn ghi cạnh app. -->
		<target xsi:type="File" name="logfile"
            fileName="${whenEmpty:inner=${environment:SIPPACK_LOG_DIR}:whenEmpty=${basedir}/Log}/Sip.be.Api_${date:format=ddMMyyyy}.log"
            layout="${longdate} | ${level:uppercase=true} | ${logger} | ${message} ${exception}"
            keepFileOpen="false"
            encoding="utf-8"
            createDirs="true"
			archiveFileName="${whenEmpty:inner=${environment:SIPPACK_LOG_DIR}:whenEmpty=${basedir}/Log}/archive/Sip.be.Api_{#}.log"
            archiveNumbering="Rolling"
            archiveEvery="Day"
            maxArchiveFiles="30" />
	</targets>
	<rules>
		<!-- Log everything from Info and above -->
		<logger name="*" minlevel="Info" writeTo="console,logfile" />
	</rules>
</nlog>